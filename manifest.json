{
  "manifest_version": 3,
  "name": "Rate Limits for Claude",
  "version": "0.1.0",
  "description": "Unofficial. Your Claude subscription 5-hour, 7-day, and Fable usage as toolbar bars colored by pace. Not affiliated with Anthropic.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["alarms", "storage", "idle"],
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Rate Limits for Claude - loading..."
  }
}
